{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/about",
        "http://localhost:3000/case-studies",
        "http://localhost:3000/case-studies/operational-variance-command-center"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "unsized-images": [
          "error",
          {
            "maxLength": 0
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "resource-summary:script:size": [
          "warn",
          {
            "maxNumericValue": 256000
          }
        ],
        "resource-summary:total:size": [
          "warn",
          {
            "maxNumericValue": 716800
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1500
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 3500
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
