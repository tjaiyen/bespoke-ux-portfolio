# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# generated by scripts/gen-pa11yci.mjs (routes derived from content; may embed a
# machine-specific PA11Y_CHROME_PATH). Regenerate with: npm run a11y:config
.pa11yci.json

# Lighthouse CI local reports
.lighthouseci/
# Any Lighthouse output dir. Reports embed a DOM snapshot of every audited page (R20),
# so they are never committed — not to a private repo that may later go public.
.lighthouseci*/

# Agent-facing operating instructions and the governance rules mirrored from the vault.
# Kept on disk (they are how this repo is worked on) but never published: the same call
# TJ made on tj-finance-portfolio. They also carry local filesystem paths.
AGENTS.md
CLAUDE.md
docs/vault/
